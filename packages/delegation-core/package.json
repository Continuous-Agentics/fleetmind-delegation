{
  "name": "@continuous-agentics/delegation-core",
  "version": "0.1.3",
  "description": "Versioned delegation contracts shared by FleetMind and OpenClaw.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "node -e \"require('fs').rmSync('test-dist',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test 'test-dist/test/**/*.test.js'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1070.0",
    "@aws-sdk/core": "3.974.27",
    "@aws-sdk/dynamodb-codec": "3.973.21",
    "@aws-sdk/lib-dynamodb": "3.1070.0",
    "@smithy/core": "3.24.6",
    "nats": "^2.29.3",
    "zod": "^3.23.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Continuous-Agentics/fleetmind-delegation.git",
    "directory": "packages/delegation-core"
  }
}
