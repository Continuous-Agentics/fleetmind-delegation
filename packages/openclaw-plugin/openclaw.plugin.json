{
  "id": "fleetmind-delegation",
  "name": "FleetMind Delegation",
  "description": "FleetMind delegation task read and lifecycle-transition tools for OpenClaw.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "tableName": {
        "type": "string",
        "minLength": 1,
        "description": "FleetMind delegation DynamoDB table name."
      },
      "awsRegion": {
        "type": "string",
        "minLength": 1,
        "description": "AWS region for the FleetMind delegation task ledger. Defaults to AWS_REGION."
      },
      "reviewerAgentIds": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "description": "OpenClaw agent IDs authorized to use human sign-off and merge tools."
      },
      "workerAgentIds": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        },
        "description": "Map each OpenClaw worker agent ID to its FleetMind worker ID for lifecycle authorization."
      },
      "terminalEvents": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "natsServers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "subjectPrefix": { "type": "string", "minLength": 1 },
          "pmAgentId": { "type": "string", "minLength": 1 }
        },
        "required": ["natsServers", "subjectPrefix", "pmAgentId"],
        "description": "Enable the plugin-owned PM subscriber for terminal NATS ship and block events."
      },
      "delegationEvents": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "natsServers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "subjectPrefix": { "type": "string", "minLength": 1 },
          "agentId": { "type": "string", "minLength": 1 },
          "workerHomeSlack": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "accountId": { "type": "string", "minLength": 1 },
              "conversationId": { "type": "string", "minLength": 1 }
            },
            "required": ["accountId", "conversationId"]
          }
        },
        "required": ["natsServers", "subjectPrefix", "agentId"],
        "description": "Enable plugin-owned worker delegation delivery. workerHomeSlack opens a per-task receipt thread when configured."
      }
    }
  },
  "contracts": {
    "tools": [
      "fleetmind_task_get",
      "fleetmind_task_list_active",
      "fleetmind_task_ack",
      "fleetmind_task_ship",
      "fleetmind_task_block",
      "fleetmind_task_signoff",
      "fleetmind_task_merge"
    ]
  },
  "toolMetadata": {
    "fleetmind_task_signoff": {
      "optional": true
    },
    "fleetmind_task_merge": {
      "optional": true
    }
  }
}
